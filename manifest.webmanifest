{
 "name": "Parametric Maker",
 "short_name": "Param Maker",
 "description": "Parametric OpenSCAD model maker for mobile",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "orientation": "any",
 "background_color": "#0f1115",
 "theme_color": "#0f1115",
 "icons": [
  {
   "src": "icon-192.png?v=3",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icon-512.png?v=3",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "icon-maskable-512.png?v=3",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "id": "/parametric-maker/",
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "url": "url",
   "files": [
    {
     "name": "scad",
     "accept": [
      "*/*",
      ".scad",
      "text/plain",
      "application/octet-stream"
     ]
    }
   ]
  }
 },
 "file_handlers": [
  {
   "action": "./",
   "accept": {
    "text/plain": [
     ".scad"
    ],
    "application/octet-stream": [
     ".scad"
    ]
   }
  }
 ]
}